{
  "name": "sentiment-chatbot-comparison",
  "version": "1.0.0",
  "description": "Chatbot with real-time sentiment analysis - Jev vs Traditional LLM comparison",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:latency": "jest --testMatch='**/latency.test.ts' --verbose",
    "test:support": "jest --testMatch='**/support-comparison.test.ts' --verbose",
    "test:real-api": "ts-node src/test-real-api.ts",
    "visualize": "ts-node src/visualize-latency.ts",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js"
  },
  "keywords": ["chatbot", "sentiment-analysis", "jev", "real-time"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "openai": "^4.28.0",
    "ws": "^8.16.0",
    "dotenv": "^16.4.5"
  }
}
