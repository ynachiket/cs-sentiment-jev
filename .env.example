# OpenRouter API Key for Jev
# Sign up at: https://openrouter.ai
# Get your key at: https://openrouter.ai/settings/keys
# Tutorial: https://openrouter.ai/docs/guides/community/jev-tutorial
OPENROUTER_API_KEY=your_openrouter_api_key_here

# For LLM comparison (optional - mocks are used by default in tests)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Environment
NODE_ENV=development
